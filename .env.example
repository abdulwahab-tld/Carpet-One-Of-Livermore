# Copy to .env.local and fill in before the estimate form can send email.
# Resend's onboarding sender can deliver only to the Resend account email
# until carpetonel.com is verified as a sending domain.

RESEND_API_KEY=
CONTACT_TO_EMAIL=sales@carpetonel.com
CONTACT_FROM_EMAIL=Living Floors <onboarding@resend.dev>

# Set this to the production origin, with no trailing slash, to enable
# the canonical URL, metadata base, and sitemap host.
NEXT_PUBLIC_SITE_URL=

# Free Google AI Studio key for the showroom assistant.
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Google Calendar service account. Share the showroom calendar with the
# service account email as "Make changes to events".
# Keep the private key on one line with \n for line breaks.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
